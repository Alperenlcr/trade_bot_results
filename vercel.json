{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/", "destination": "/", "permanent": true },
    { "source": "/", "destination": "/tr/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": { "pre": "tr" } }],
      "missing": [{ "type": "cookie", "key": "lang" }] },
    { "source": "/", "destination": "/ar/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": { "pre": "ar" } }],
      "missing": [{ "type": "cookie", "key": "lang" }] },
    { "source": "/", "destination": "/zh/", "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": { "pre": "zh" } }],
      "missing": [{ "type": "cookie", "key": "lang" }] }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
