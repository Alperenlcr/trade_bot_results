---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { languages, type Lang, type RouteKey } from '../i18n/utils';
// Arapça metin fontu geç gelince paragraflar yeniden diziliyordu (Lighthouse CLS 0,16); ar sayfalarda önden yüklenir.
import arabicFont from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  route?: RouteKey;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { lang, route, ...seo } = Astro.props;
---
<!doctype html>
<html lang={languages[lang].hreflang} dir={languages[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {lang === 'en' && route === 'home' && (
      // vercel.json'daki dil yönlendirmesinin tarayıcı yedeği (GitHub Pages'te sunucu kuralı yok).
      // Dil menüsünden seçim yapılmışsa (lang çerezi) dokunmaz.
      <script is:inline>
        if (!/(^|; )lang=/.test(document.cookie)) {
          var l = (navigator.language || '').slice(0, 2);
          if (l === 'tr' || l === 'ar' || l === 'zh') location.replace('/' + l + '/' + location.search + location.hash);
        }
      </script>
    )}
    {lang === 'ar' && <link rel="preload" href={arabicFont} as="font" type="font/woff2" crossorigin />}
    <SEO lang={lang} route={route} {...seo} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header lang={lang} route={route} />
    <main class="flex-1"><slot /></main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
