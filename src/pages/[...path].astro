---
// Tüm dillerdeki tüm sayfalar src/i18n/utils.ts slug tablosundan, blog yazıları src/content/blog'dan üretilir.
import HomePage from '../components/HomePage.astro';
import ContentPage from '../components/ContentPage.astro';
import BlogIndex from '../components/BlogIndex.astro';
import BlogPost from '../components/BlogPost.astro';
import { getPath, langs, routeKeys, type Lang, type RouteKey } from '../i18n/utils';
import { archivedVersions } from '../lib/versions';
import { getPosts, postLang, postPath, type Post } from '../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const toParam = (path: string) => path.replace(/^\/|\/$/g, '') || undefined;
  return [
    ...langs.flatMap((lang) =>
      routeKeys.map((route) => ({ params: { path: toParam(getPath(route, lang)) }, props: { lang, route, posts } })),
    ),
    // Arşivlenmiş bot sürümlerinin ana sayfaları: /v6/, /tr/v6/ …
    ...archivedVersions().flatMap((v) => langs.map((lang) => ({
      params: { path: toParam(getPath('home', lang, v.id)) }, props: { lang, route: 'home' as RouteKey, posts, version: v.id },
    }))),
    ...posts.map((post) => ({ params: { path: toParam(postPath(post)) }, props: { lang: postLang(post), post, posts } })),
  ];
}

const { lang, route, post, posts, version } = Astro.props as { lang: Lang; route?: RouteKey; post?: Post; posts: Post[]; version?: string };
---
{post ? <BlogPost post={post} posts={posts} />
  : route === 'home' ? <HomePage lang={lang} version={version} />
  : route === 'blog' ? <BlogIndex lang={lang} posts={posts} />
  : <ContentPage lang={lang} route={route!} />}
