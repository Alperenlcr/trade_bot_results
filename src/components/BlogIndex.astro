---
// Bir dilin blog listesi; yazı yoksa placeholder.
import BaseLayout from '../layouts/BaseLayout.astro';
import { languages, useTranslations, type Lang } from '../i18n/utils';
import { postLang, postPath, type Post } from '../lib/blog';

interface Props { lang: Lang; posts: Post[] }
const { lang } = Astro.props;
const t = useTranslations(lang);
const page = t.pages.blog;
const posts = Astro.props.posts.filter((p) => postLang(p) === lang);
const date = new Intl.DateTimeFormat(languages[lang].hreflang, { dateStyle: 'long' });
---
<BaseLayout lang={lang} route="blog" title={`${page.title} — Executor Trading`} description={page.description}>
  <div class="mx-auto max-w-3xl px-6 py-20">
    <h1 class="text-4xl font-bold">{page.title}</h1>
    {posts.length ? (
      <ul class="mt-10 space-y-10">
        {posts.map((p) => (
          <li>
            <article>
              <time datetime={p.data.pubDate.toISOString()} class="text-sm text-text-soft">{date.format(p.data.pubDate)}</time>
              <h2 class="mt-1 text-2xl font-bold"><a href={postPath(p)} class="hover:text-accent">{p.data.title}</a></h2>
              <p class="mt-3 leading-relaxed text-text-soft">{p.data.description}</p>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-text-soft">{t.placeholder}</p>
    )}
  </div>
</BaseLayout>
