---
import config from '../../data/config.json';
import { getPath, langs, languages, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  route?: RouteKey;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, lang, route, schema = [], noindex = false } = Astro.props;
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const canonical = route ? abs(getPath(route, lang)) : undefined;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Executor Trade',
  url: abs('/'),
  logo: abs('/logo.png'),
  sameAs: Object.values(config.social).filter(Boolean),
};

const breadcrumb = route && route !== 'home' && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Executor Trade', item: abs(getPath('home', lang)) },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};

const jsonLd = [organization, breadcrumb, ...schema].filter(Boolean);
---
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#101826" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{route && (
  <>
    {langs.map((l) => <link rel="alternate" hreflang={languages[l].hreflang} href={abs(getPath(route, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(getPath(route, 'en'))} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Executor Trade" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={languages[lang].ogLocale} />
{langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
<meta property="og:image" content={abs(`/og/${lang}.png`)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
