---
import config from '../../data/config.json';
import { getPath, langs, languages, type Lang, type RouteKey } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  route?: RouteKey;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Blog yazısı: çevirilerin adresleri (yoksa route'tan tüm diller), kapak görseli, yayın tarihi (og:type=article). */
  alternates?: Partial<Record<Lang, string>>;
  image?: string;
  published?: Date;
}

const { title, description, lang, route, schema = [], noindex = false, alternates: alts, image, published } = Astro.props;
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href;
const alternates = alts ?? (route ? Object.fromEntries(langs.map((l) => [l, getPath(route, l)])) as Record<Lang, string> : {});
const altLangs = langs.filter((l) => alternates[l]);
const canonical = alternates[lang] && abs(alternates[lang]);
const xDefault = alternates.en ?? alternates[altLangs[0]];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Executor Trading',
  url: abs('/'),
  logo: abs('/logo.png'),
  sameAs: Object.values(config.social).filter(Boolean),
};

const breadcrumb = route && route !== 'home' && !alts && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Executor Trading', item: abs(getPath('home', lang)) },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};

const jsonLd = [organization, breadcrumb, ...schema].filter(Boolean);
---
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#101826" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{xDefault && (
  <>
    {altLangs.map((l) => <link rel="alternate" hreflang={languages[l].hreflang} href={abs(alternates[l]!)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />
  </>
)}
<meta property="og:type" content={published ? 'article' : 'website'} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
<meta property="og:site_name" content="Executor Trading" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={languages[lang].ogLocale} />
{altLangs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
<meta property="og:image" content={abs(image ?? `/og/${lang}.png`)} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
