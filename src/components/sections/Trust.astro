---
import { useTranslations, type Lang } from '../../i18n/utils';
const t = useTranslations(Astro.props.lang as Lang);
---
<section class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="text-3xl font-bold">{t.trust.title}</h2>
  <ul class="mt-8 space-y-3">
    {t.trust.items.map((item) => (
      <li class="flex gap-3 text-text-soft"><span class="text-positive" aria-hidden="true">✓</span>{item}</li>
    ))}
  </ul>
</section>
