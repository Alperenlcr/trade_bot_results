---
import { useTranslations, type Lang } from '../../i18n/utils';
const t = useTranslations(Astro.props.lang as Lang);
---
<section class="mx-auto max-w-6xl px-6 py-20">
  <h2 class="text-3xl font-bold">{t.how.title}</h2>
  <ol class="mt-10 grid gap-6 md:grid-cols-3">
    {t.how.steps.map((step, i) => (
      <li class="rounded-l border border-border bg-surface p-6">
        <span class="font-display text-accent">0{i + 1}</span>
        <h3 class="mt-3 text-lg font-bold">{step.title}</h3>
        <p class="mt-2 text-text-soft">{step.body}</p>
      </li>
    ))}
  </ol>
</section>
