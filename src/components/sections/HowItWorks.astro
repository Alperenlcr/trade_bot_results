---
import { useTranslations, type Lang } from '../../i18n/utils';
const t = useTranslations(Astro.props.lang as Lang);
---
<!-- App.tsx bölümleriyle aynı görünüm: .sec/.tile sınıfları global.css › .app; kapsayıcı wrap (1200px, 24px) ile hizalı. -->
<div class="mx-auto max-w-6xl px-6">
  <section class="sec">
    <div class="sec-head">
      <div class="eyebrow">{t.how.eyebrow}</div>
      <h2 class="sec-title">{t.how.title}</h2>
    </div>
    <ol class="grid gap-3.5 md:grid-cols-3">
      {t.how.steps.map((step, i) => (
        <li class="lift tile">
          <span class="font-display text-accent">0{i + 1}</span>
          <h3 style="font-family:var(--font-display);font-weight:600;font-size:17px;margin:9px 0;letter-spacing:-.3px">{step.title}</h3>
          <p style="font-size:14px;color:var(--text-dim);line-height:1.62">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>
</div>
